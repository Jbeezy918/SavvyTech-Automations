<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>H Mountain Retreat</title>
<style>
:root{
  --forest:#18392b;--pine:#24513d;--sage:#dce8df;--mist:#edf3ef;
  --gold:#d2a255;--cream:#f5f1e8;--ink:#17231d;--white:#fff;
}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif;color:var(--ink);
background:linear-gradient(rgba(237,243,239,.96),rgba(237,243,239,.96)),
url('https://images.unsplash.com/photo-1441974231531-c6227db76b6e?auto=format&fit=crop&w=2200&q=84') center/cover fixed}
a{text-decoration:none;color:inherit}
nav{position:absolute;z-index:20;width:100%;display:flex;justify-content:space-between;align-items:center;padding:18px 5%;color:#fff}
.brand{display:flex;align-items:center;gap:8px;font-weight:900;letter-spacing:.14em}
.brand-logo{width:66px;height:66px;object-fit:cover;border-radius:50%;
border:2px solid rgba(255,255,255,.92);box-shadow:0 5px 18px rgba(0,0,0,.28)}
.navlinks{display:flex;gap:24px;align-items:center;font-weight:700}
.btn{display:inline-flex;align-items:center;justify-content:center;padding:14px 22px;border-radius:999px;background:var(--gold);color:#17231d;font-weight:900;border:0;cursor:pointer}
.btn.alt{background:#fff;color:var(--forest)}
.hero{min-height:92vh;display:grid;place-items:center;text-align:center;color:#fff;padding:120px 20px 70px;
background:linear-gradient(rgba(9,25,18,.38),rgba(9,25,18,.72)),
url('https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=2200&q=88') center/cover}
.hero-inner{max-width:930px}.eyebrow{text-transform:uppercase;letter-spacing:.25em;font-weight:900;font-size:.78rem}
h1,h2,h3{font-family:Georgia,serif}
h1{font-size:clamp(3.2rem,8vw,7.2rem);line-height:.92;margin:18px 0 24px}
.hero p{font-size:clamp(1.03rem,2vw,1.32rem);line-height:1.6;max-width:760px;margin:0 auto 34px}
.hero-actions{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
section{padding:82px 6%}
.section-head{max-width:780px;margin-bottom:38px}.kicker{color:var(--pine);font-weight:900;letter-spacing:.18em;text-transform:uppercase;font-size:.75rem}
h2{font-size:clamp(2.3rem,5vw,4.2rem);line-height:1.05;margin:12px 0}
.intro{background:linear-gradient(rgba(233,241,235,.88),rgba(233,241,235,.88)),
url('https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=2200&q=84') center/cover}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.card{background:rgba(255,255,255,.95);border-radius:22px;overflow:hidden;box-shadow:0 14px 40px rgba(20,40,30,.13)}
.card img{width:100%;height:230px;object-fit:cover}.card-body{padding:24px}.card h3{font-size:1.55rem;margin:0 0 10px}.card p{line-height:1.65;color:#526057}
.rate{font-weight:900;color:var(--forest);margin-top:16px}
.map-section{background:linear-gradient(rgba(18,49,35,.80),rgba(18,49,35,.88)),
url('https://images.unsplash.com/photo-1441974231531-c6227db76b6e?auto=format&fit=crop&w=2200&q=85') center/cover;color:#fff}
.map-section .kicker{color:#e8bc70}.map-section p{color:#d8e3dc;line-height:1.7}
.camp-map{position:relative;min-height:720px;border-radius:28px;overflow:hidden;margin-top:34px;
background:
linear-gradient(rgba(8,38,22,.10),rgba(8,38,22,.18)),
url('assets/actual-property-aerial.jpg') center/cover;
box-shadow:0 20px 60px rgba(0,0,0,.30);border:1px solid rgba(255,255,255,.30)}
.map-shade{position:absolute;inset:0;background:radial-gradient(circle at center,transparent 32%,rgba(4,29,17,.24) 100%)}
.trail-svg{position:absolute;inset:0;width:100%;height:100%;filter:drop-shadow(0 3px 3px rgba(0,0,0,.28))}
.trail-edge{fill:none;stroke:#715534;stroke-width:31;stroke-linecap:round;stroke-linejoin:round;opacity:.85}
.trail-main{fill:none;stroke:#b48b58;stroke-width:23;stroke-linecap:round;stroke-linejoin:round}
.clearing{position:absolute;width:76px;height:58px;border-radius:48% 52% 44% 56%;
background:radial-gradient(ellipse at center,#b89a66 0 45%,#90774f 58%,rgba(63,92,51,.78) 69%,rgba(19,67,38,.05) 74%);
transform:translate(-50%,-50%);display:grid;place-items:center;filter:drop-shadow(0 6px 8px rgba(0,0,0,.35))}
.site{width:36px;height:36px;border-radius:50%;border:2px solid #fff;background:#174d35;color:#fff;
font-weight:900;font-size:.78rem;cursor:pointer;box-shadow:0 5px 12px rgba(0,0,0,.40);transition:.18s}
.site:hover{transform:scale(1.16);background:#d2a255;color:#17231d}
.legend{position:absolute;left:20px;bottom:20px;background:rgba(255,255,255,.94);color:var(--ink);
padding:13px 16px;border-radius:14px;font-size:.86rem;box-shadow:0 8px 22px rgba(0,0,0,.18)}
.map-title{position:absolute;right:20px;top:20px;background:rgba(16,54,37,.90);padding:11px 15px;border-radius:14px;
font-size:.82rem;color:#fff;border:1px solid rgba(255,255,255,.28)}
@media(max-width:850px){.navlinks a:not(.btn){display:none}.grid3,.event-strip{grid-template-columns:1fr}.camp-map{min-height:620px}.clearing{width:58px;height:46px}.site{width:30px;height:30px;font-size:.7rem}.form-grid{grid-template-columns:1fr}.full{grid-column:auto}}
</style>
</head>
<body>
<nav>
  <div class="brand"><img class="brand-logo" src="assets/h-logo-night.jpg" alt="H Mountain logo"><span>MOUNTAIN</span></div>
  <div class="navlinks"><a href="#stay">Stay</a><a href="#sites">Campsites</a><a href="#events">Gather</a><a href="#sites" class="btn">Check Availability</a></div>
</nav>

<header class="hero">
  <div class="hero-inner">
    <div class="eyebrow">H Mountain Retreat · Interactive Preview</div>
    <h1>Find Your Way Back to Nature.</h1>
    <p>Wooded campsites, peaceful gatherings, family weekends and unforgettable nights under the stars—just outside McAlester, Oklahoma.</p>
    <div class="hero-actions"><a class="btn" href="#sites">Choose a Campsite</a><a class="btn alt" href="#stay">Explore the Retreat</a></div>
  </div>
</header>

<section id="stay" class="intro branded-section"><img class="brand-watermark" src="assets/h-logo-day.jpg" alt="">
  <div class="section-head"><div class="kicker">Stay your way</div><h2>Room to breathe. Space to belong.</h2><p>Choose a secluded campsite, settle in for a longer stay, or bring everyone together for a private celebration.</p></div>
  <div class="grid3">
    <article class="card"><img src="https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?auto=format&fit=crop&w=1000&q=82"><div class="card-body"><h3>Wooded Campsites</h3><p>Private, tree-lined spaces for tents, campers and slow mornings outdoors.</p><div class="rate">Sample: from $45/night</div></div></article>
    <article class="card"><img src="https://images.unsplash.com/photo-1523987355523-c7b5b0dd90a7?auto=format&fit=crop&w=1000&q=82"><div class="card-body"><h3>Extended Stays</h3><p>Weekly and monthly options for guests who want more than a weekend escape.</p><div class="rate">Sample: from $225/week</div></div></article>
    <article class="card"><img src="https://images.unsplash.com/photo-1475483768296-6163e08872a1?auto=format&fit=crop&w=1000&q=82"><div class="card-body"><h3>Private Gatherings</h3><p>Family reunions, birthdays, retreats and relaxed celebrations surrounded by nature.</p><div class="rate">Custom event pricing</div></div></article>
  </div>
</section>

<section id="sites" class="map-section branded-section">
  <img class="brand-watermark" src="assets/h-logo-day.jpg" alt="">
  <div class="section-head"><div class="kicker">Interactive campsite map</div><h2>Choose your place in the woods.</h2><p>This preview uses the actual aerial property image. Twelve sample campsites sit along one private dirt trail; each numbered clearing opens its own reservation calendar.</p></div>
  <div class="camp-map">
    <div class="map-shade"></div>
    <svg class="trail-svg" viewBox="0 0 1000 720" preserveAspectRatio="none" aria-hidden="true">
      <path class="trail-edge" d="M105,115 C260,165 375,215 485,290 C600,370 705,450 865,610"/>
      <path class="trail-main" d="M105,115 C260,165 375,215 485,290 C600,370 705,450 865,610"/>
    </svg>
    <div class="map-title">ACTUAL PROPERTY AERIAL · SAMPLE LAYOUT</div>
    <div class="clearing" style="left:18%;top:22%">
        <button class="site" title="Campsite 1" onclick="openSite('Campsite 1','$45/night','Cleared wooded campsite beside the private dirt trail')">1</button>
      </div><div class="clearing" style="left:33%;top:27%">
        <button class="site" title="Campsite 2" onclick="openSite('Campsite 2','$45/night','Cleared wooded campsite beside the private dirt trail')">2</button>
      </div><div class="clearing" style="left:48%;top:33%">
        <button class="site" title="Campsite 3" onclick="openSite('Campsite 3','$45/night','Cleared wooded campsite beside the private dirt trail')">3</button>
      </div><div class="clearing" style="left:63%;top:40%">
        <button class="site" title="Campsite 4" onclick="openSite('Campsite 4','$55/night','Cleared wooded campsite beside the private dirt trail')">4</button>
      </div><div class="clearing" style="left:76%;top:49%">
        <button class="site" title="Campsite 5" onclick="openSite('Campsite 5','$45/night','Cleared wooded campsite beside the private dirt trail')">5</button>
      </div><div class="clearing" style="left:84%;top:62%">
        <button class="site" title="Campsite 6" onclick="openSite('Campsite 6','$45/night','Cleared wooded campsite beside the private dirt trail')">6</button>
      </div><div class="clearing" style="left:23%;top:42%">
        <button class="site" title="Campsite 7" onclick="openSite('Campsite 7','$45/night','Cleared wooded campsite beside the private dirt trail')">7</button>
      </div><div class="clearing" style="left:37%;top:49%">
        <button class="site" title="Campsite 8" onclick="openSite('Campsite 8','$55/night','Cleared wooded campsite beside the private dirt trail')">8</button>
      </div><div class="clearing" style="left:51%;top:57%">
        <button class="site" title="Campsite 9" onclick="openSite('Campsite 9','$45/night','Cleared wooded campsite beside the private dirt trail')">9</button>
      </div><div class="clearing" style="left:64%;top:66%">
        <button class="site" title="Campsite 10" onclick="openSite('Campsite 10','$45/night','Cleared wooded campsite beside the private dirt trail')">10</button>
      </div><div class="clearing" style="left:48%;top:73%">
        <button class="site" title="Campsite 11" onclick="openSite('Campsite 11','$45/night','Cleared wooded campsite beside the private dirt trail')">11</button>
      </div><div class="clearing" style="left:31%;top:79%">
        <button class="site" title="Campsite 12" onclick="openSite('Campsite 12','$55/night','Cleared wooded campsite beside the private dirt trail')">12</button>
      </div>
    <div class="legend">12 sample sites · click any numbered clearing to open its calendar.</div>
  </div>
</section>

<section class="events branded-section" id="events"><img class="brand-watermark" src="assets/h-logo-day.jpg" alt="">
  <div class="event-strip">
    <div class="event-photo" role="img" aria-label="Outdoor gathering in nature"></div>
    <div class="event-copy"><div class="kicker">Gather at H Mountain</div><h2>Make the woods yours for the day.</h2><p>Plan a relaxed event without fluorescent lights and hotel ballroom carpet.</p>
      <ul><li>Birthday parties and family reunions</li><li>Company and church retreats</li><li>Outdoor dinners and catering</li><li>Private group reservations</li></ul>
      <a href="mailto:hello@hmountainretreat.com?subject=H%20Mountain%20Event%20Inquiry" class="btn">Request Event Information</a>
    </div>
  </div>
</section>

<footer>
  <div><div class="brand"><img class="brand-logo" src="assets/h-logo-night.jpg" alt="H Mountain logo"><span>MOUNTAIN</span></div><p class="small">A peaceful wooded retreat near McAlester, Oklahoma.</p></div>
  <div class="small">Prototype page · Sample pricing and availability<br>© 2026 H Mountain Retreat</div>
</footer>

<div class="modal" id="siteModal" onclick="outsideClose(event)">
  <div class="modal-card">
    <div class="modal-top"><div><div class="kicker">Reserve this site</div><h2 id="siteName" style="font-size:2.4rem;margin-bottom:8px">Campsite</h2><strong id="siteRate"></strong><p id="siteDesc"></p></div><button class="close" onclick="closeSite()">×</button></div>
    <div class="form-grid">
      <div><label>ARRIVAL</label><input type="date"></div>
      <div><label>DEPARTURE</label><input type="date"></div>
      <div><label>GUESTS</label><select><option>1–2 guests</option><option>3–5 guests</option><option>6–10 guests</option></select></div>
      <div><label>STAY TYPE</label><select><option>Nightly</option><option>Weekly</option><option>Monthly</option></select></div>
      <button class="btn full" onclick="alert('Sample reservation started. This will connect to the real booking and deposit system.')">Continue to Reservation</button>
    </div>
  </div>
</div>

<script>
function openSite(name,rate,desc){
 document.getElementById('siteName').textContent=name;
 document.getElementById('siteRate').textContent=rate;
 document.getElementById('siteDesc').textContent=desc;
 document.getElementById('siteModal').classList.add('open');
}
function closeSite(){document.getElementById('siteModal').classList.remove('open')}
function outsideClose(e){if(e.target.id==='siteModal')closeSite()}
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeSite()})
</script>
</body>
</html>